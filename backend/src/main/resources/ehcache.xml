<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3" xmlns:jsr107="http://www.ehcache.org/v3/jsr107">
  <service>
    <jsr107:defaults enable-statistics="true"/>
  </service>

  <!-- A single post by id: many entries, long-lived, evicted precisely on update/delete. -->
  <cache alias="post">
    <expiry><ttl unit="minutes">10</ttl></expiry>
    <heap unit="entries">2000</heap>
  </cache>

  <!-- Whole pages keyed by (status, platform, page, size, sort): cheap to rebuild, so short TTL and
       dropped entirely on any write because any write can reorder or resize any page. -->
  <cache alias="postPages">
    <expiry><ttl unit="seconds">60</ttl></expiry>
    <heap unit="entries">500</heap>
  </cache>

  <!-- Dashboard aggregates: one or two entries, the most expensive reads, the most tolerant of staleness. -->
  <cache alias="stats">
    <expiry><ttl unit="minutes">5</ttl></expiry>
    <heap unit="entries">10</heap>
  </cache>
</config>
